  "templates": [
    {
      "id": "facts",
      "title": "事实层",
      "group": "story",
      "feed": "up",
      "note": "客观发生了什么：谁、在哪、何时、做了什么、怎么发生的。不含任何人的理解。",
      "shape": {
        "kind": "list",
        "item": "事实",
        "fields": [
          {
            "key": "who",
            "label": "谁"
          },
          {
            "key": "where",
            "label": "哪"
          },
          {
            "key": "when",
            "label": "何时"
          },
          {
            "key": "what",
            "label": "做了什么"
          },
          {
            "key": "how",
            "label": "怎么发生的"
          }
        ]
      },
      "doctrine": "【任务】把客观发生过的事拆成条目。\n【读】上游故事/梗概。\n【写】事实层.md。\n【格式】一条事实一行，五个字段都要填。\n【规矩】只记录事实，不写理解、推测、情绪——那是认知层的事。"
    },
    {
      "id": "character",
      "title": "人物",
      "group": "story",
      "feed": "up",
      "note": "只列人物名字（一条一个），小传放下游节点。",
      "shape": {
        "kind": "text"
      },
      "doctrine": "【任务】用一句话列清这部片有哪些人：姓名 + 一个标签（职业/关系）。\n【读】剧本或事实层。\n【写】人物.md\n【格式】纯文本，一行一个：`唐老板（便利店夜班店主）、林默（记者）`\n【规矩】这里只列名字和一句话标签。每个人的身份/性格/外貌/服装，各建一个「人物·单人」节点挂在它下游，再往下挂属性。",
      "kind": "aggregate"
    },
    {
      "id": "character-one",
      "title": "人物·单人",
      "note": "节点标题写人名；正文只写一句话定位",
      "kind": "aggregate",
      "shape": {
        "kind": "text"
      },
      "doctrine": "【任务】这一个人是谁：**节点标题就是人名**（建好后把标题改成「唐老板」这种），正文只写一句话定位（职业/年龄/在这故事里的作用）。\n【读】人物、剧本。\n【写】工艺/<人名>.md\n【格式】纯文本，一句话；没有可写的就留空，别写「某某·单人」这种重复。\n【规矩】身份/性格/外貌/服装 挂在它下游，别写在这里；剧本没写的标〔推断〕或 TODO。"
    },
    {
      "id": "identity",
      "title": "身份",
      "group": "story",
      "feed": "up",
      "note": "身份（单人）",
      "shape": {
        "kind": "text"
      },
      "doctrine": "【任务】写这个人的身份、职业、立场。\n【读】人物·单人节点、剧本。\n【写】本节点的 md。\n【格式】几行，每行 `标签：内容`：身份 / 职业 / 立场。\n【规矩】剧本没写的标〔推断〕或 TODO；只写这一个人。"
    },
    {
      "id": "personality",
      "title": "性格",
      "group": "story",
      "feed": "up",
      "note": "性格（单人）",
      "shape": {
        "kind": "text"
      },
      "doctrine": "【任务】写这个人的性格关键词 + 可拍的行为习惯/口头禅。\n【读】人物·单人节点、剧本。\n【写】本节点的 md。\n【格式】几行：`关键词：` `习惯：` `口头禅：`（没有就省略）。\n【规矩】关键词要能演出来，不写\"善良\"这种空词；只写这一个人。"
    },
    {
      "id": "appearance",
      "title": "外貌",
      "group": "story",
      "feed": "up",
      "note": "外貌（单人）",
      "shape": {
